    "Sublist will remind you the day before any subscription renews.": {
      "comment": "Settings notifications section footer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublist will remind you the day before any subscription renews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublist te recordará el día antes de que se renueve cualquier suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublist vous rappellera la veille du renouvellement de chaque abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublist erinnert dich einen Tag vor der Verlängerung jedes Abonnements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublist ti ricorderà il giorno prima del rinnovo di ogni abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublistはサブスクが更新される前日にリマインドします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublist 将在订阅续订前一天提醒你。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sublist vai te lembrar no dia anterior à renovação de cada assinatura."
          }
        }
      }
