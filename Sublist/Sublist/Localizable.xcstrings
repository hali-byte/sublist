    "%@ Your %@ trial ends soon — you'll be charged %@. Cancel now if you don't want to keep it." : {
      "comment" : "Trial reminder body. Parameters: emoji, subscription name, formatted price",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Deine %@-Testphase endet bald – dir werden %@ berechnet. Kündige jetzt, wenn du es nicht behalten willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Your %@ trial ends soon — you'll be charged %@. Cancel now if you don't want to keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tu prueba de %@ termina pronto: se te cobrarán %@. Cancela ahora si no quieres conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ton essai %@ se termine bientôt – tu seras facturé %@. Annule maintenant si tu ne veux pas le garder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La tua prova di %@ sta per finire: ti verranno addebitati %@. Annulla ora se non vuoi tenerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ のトライアルがまもなく終了します。%@ が請求されます。継続しない場合は今すぐ解約してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Seu teste do %@ está acabando — você será cobrado %@. Cancele agora se não quiser manter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 你的 %@ 试用即将结束，将向你收取 %@。如不想继续，请立即取消。"
          }
        }
      }
    },
