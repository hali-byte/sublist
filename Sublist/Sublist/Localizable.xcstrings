          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos detectado que estás en %@. Esto se usa para obtener precios de suscripción precisos para tu región."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
