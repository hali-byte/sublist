    "Add anything you pay for regularly — streaming, tools, memberships.": {
      "comment": "Empty state description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add anything you pay for regularly — streaming, tools, memberships."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade todo lo que pagas regularmente: streaming, herramientas, membresías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez tout ce que vous payez régulièrement : streaming, outils, abonnements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge alles hinzu, wofür du regelmäßig zahlst: Streaming, Tools, Mitgliedschaften."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi tutto ciò per cui paghi regolarmente: streaming, strumenti, abbonamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミング、ツール、メンバーシップなど、定期的に支払うものをすべて追加しよう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你定期付费的所有服务——流媒体、工具、会员资格。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione tudo o que você paga regularmente — streaming, ferramentas, assinaturas."
          }
        }
      }
    },
