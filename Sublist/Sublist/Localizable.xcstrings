        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désolé, nous n'avons pas pu récupérer les tarifs de %@. Ajoutez le prix manuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siamo spiacenti, non è stato possibile recuperare i prezzi di %@. Inserisci il prezzo manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "申し訳ありません。%@の最新料金を取得できませんでした。価格を手動で入力してください。"
