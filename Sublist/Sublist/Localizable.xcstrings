    "Sorry! We could not fetch the latest pricing for %@, add the price manually." : {
      "comment" : "Fallback message when pricing fetch fails. %@ is the service name (e.g. Spotify).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entschuldigung! Wir konnten die aktuellen Preise für %@ nicht abrufen. Füge den Preis manuell hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorry! We could not fetch the latest pricing for %@, add the price manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sentimos, no pudimos obtener los precios de %@. Añade el precio manualmente."
